# Server
PORT=3000
# Origin của frontend được phép gọi API (CORS)
CLIENT_URL=http://localhost:5173

# JWT (đặt chuỗi ngẫu nhiên dài, ví dụ: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Supabase (Project Settings > API). SERVICE ROLE KEY chỉ dùng ở backend, KHÔNG commit.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Gemini (tuỳ chọn, chỉ cần khi dùng geminiImageService). Lấy key ở Google AI Studio, KHÔNG commit.
GEMINI_API_KEY=
# Mặc định: gemini-3.1-flash-image
GEMINI_IMAGE_MODEL=

# Phòng thử đồ (try-on). Provider: stub (mặc định, ảnh mô phỏng, không gọi mạng) | gemini (cần GEMINI_API_KEY ở trên)
TRY_ON_PROVIDER=stub
# Hạn mức lượt tạo ảnh / user / ngày (giờ Việt Nam)
TRY_ON_DAILY_LIMIT=30
# Thời gian tối đa cho 1 lần tạo ảnh (ms) và số job chạy đồng thời
TRY_ON_TIMEOUT_MS=90000
TRY_ON_MAX_CONCURRENCY=3
# Chỉ cho provider stub: success | fail | slow (vượt timeout); độ trễ giả lập (ms)
TRY_ON_STUB_MODE=success
TRY_ON_STUB_DELAY_MS=2000
