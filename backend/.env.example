# Server
PORT=3000
# Origin của frontend được phép gọi API (CORS)
CLIENT_URL=http://localhost:5173

# JWT (đặt chuỗi ngẫu nhiên dài, ví dụ: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Supabase (Project Settings > API). SERVICE ROLE KEY chỉ dùng ở backend, KHÔNG commit.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
